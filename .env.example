# DB de la market memory (scraping_station).
# NE JAMAIS committer .env. Le DSN ci-dessous est un exemple : mettre la vraie
# valeur dans .env local. ⚠️ Le credential historique en clair doit être ROTATIONNÉ.
EVENTS_DSN=postgresql://USER:PASSWORD@HOST:5433/scraping_station

# Serveur MCP (à venir) : token bearer + surface d'outils scopés.
MCP_HTTP_TOKEN=
MCP_HTTP_PORT=8788
